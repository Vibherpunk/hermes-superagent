+def test_kanban_worker_policy_toolset_exclusions(tmp_path, monkeypatch):
+    """Kanban worker policy strips deny toolsets, keeps kanban, and merges into disabled_toolsets."""
+    from contextlib import closing
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect
+    from gateway.session_contract import Principal
+    from gateway.session_kanban import build_kanban_policy
+    from gateway.session_policy import build_policy
+    import model_tools
+    from tools.delegate_tool_toolsets import (
+        KANBAN_WORKER_BLOCKED_TOOLS,
+        kanban_worker_deny_toolsets,
+    )
+
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path))
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setenv('HOME', str(tmp_path / 'home'))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    monkeypatch.delenv('HERMES_DELEGATED_CHILD', raising=False)
+    monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env', lambda name: str(tmp_path) if name == 'default' else str(tmp_path / name))
+
+    workspace = tmp_path / 'workspace'
+    workspace.mkdir()
+    kb.create_board('owned')
+    with closing(connect(board='owned')) as conn:
+        task_id = kb.create_task(conn, title='Worker exclusions', body='Criteria', assignee='default',
+                                 workspace_kind='dir', workspace_path=str(workspace))
+        kb.recompute_ready(conn)
+        task = kb.claim_task(conn, task_id)
+
+    actor = Principal('owner', str(tmp_path), frozenset({'session:create'}), 'transport')
+    connection = SimpleNamespace(authority=SimpleNamespace(profile_id=str(tmp_path)), actor=actor, native_owner=True)
+    params = dict(board='owned', task_id=task.id, run_id=task.current_run_id, claim_lock=task.claim_lock)
+
+    deny_toolsets = kanban_worker_deny_toolsets()
+
+    # 1. Config platform_toolsets.cli: [terminal, file, memory, clarify, delegation, cronjob, desktop_ui, project] with agent.disabled_toolsets ['web']:
+    # policy.toolsets == ('file','kanban','terminal'); frozen agent.disabled_toolsets starts with 'web' and contains all 8 deny toolsets.
+    config = {
+        'model': {'default': 'loop-model', 'provider': 'custom'},
+        'platform_toolsets': {'cli': ['terminal', 'file', 'memory', 'clarify', 'delegation', 'cronjob', 'desktop_ui', 'project']},
+        'agent': {'disabled_toolsets': ['web']},
+    }
+    policy, _ = build_kanban_policy(connection, params, config)
+    assert policy.toolsets == ('file', 'kanban', 'terminal')
+    frozen = json.loads(policy.config_json)
+    disabled = frozen['agent']['disabled_toolsets']
+    assert disabled[0] == 'web'
+    assert set(deny_toolsets) <= set(disabled)
+
+    # 2. String form agent.disabled_toolsets: "['web']" merges correctly.
+    config_str = {
+        'model': {'default': 'loop-model', 'provider': 'custom'},
+        'platform_toolsets': {'cli': ['terminal', 'file', 'memory', 'clarify', 'delegation', 'cronjob', 'desktop_ui', 'project']},
+        'agent': {'disabled_toolsets': "['web']"},
+    }
+    policy_str, _ = build_kanban_policy(connection, params, config_str)
+    assert policy_str.toolsets == ('file', 'kanban', 'terminal')
+    frozen_str = json.loads(policy_str.config_json)
+    disabled_str = frozen_str['agent']['disabled_toolsets']
+    assert disabled_str[0] == 'web'
+    assert set(deny_toolsets) <= set(disabled_str)
+
+    # 3. Mixed composite platform_toolsets.cli: [coding]: model_tools.get_tool_definitions(enabled_toolsets=list(policy.toolsets), disabled_toolsets=<frozen disabled>, quiet_mode=True) returns names disjoint from KANBAN_WORKER_BLOCKED_TOOLS, with 'terminal' still present.
+    config_coding = {
+        'model': {'default': 'loop-model', 'provider': 'custom'},
+        'platform_toolsets': {'cli': ['coding']},
+        'agent': {'disabled_toolsets': []},
+    }
+    policy_coding, _ = build_kanban_policy(connection, params, config_coding)
+    frozen_coding = json.loads(policy_coding.config_json)
+    disabled_coding = frozen_coding['agent']['disabled_toolsets']
+    defs = model_tools.get_tool_definitions(
+        enabled_toolsets=list(policy_coding.toolsets),
+        disabled_toolsets=disabled_coding,
+        quiet_mode=True,
+    )
+    names = {d['function']['name'] for d in defs}
+    assert names.isdisjoint(KANBAN_WORKER_BLOCKED_TOOLS)
+    assert 'terminal' in names
+
+    # 4. Scope guard: a plain build_policy({'source':'cli', 'cwd': ...}, same_config, private_secrets={}) with the same config still includes memory and clarify (only kanban workers change).
+    plain_policy = build_policy({'source': 'cli', 'cwd': str(workspace)}, config, private_secrets={})
+    assert 'memory' in plain_policy.toolsets
+    assert 'clarify' in plain_policy.toolsets
