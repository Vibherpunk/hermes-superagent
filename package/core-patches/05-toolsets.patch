+@_kanban_handler("kanban_handback")
+def _handle_handback(args: dict, **kw) -> str:
+    """Hand back a received trigger/follow-up that is out of scope for this task (E-027)."""
+    _reject_delegated_child_mutation("kanban_handback")
+    if "ticket_id" in args and "task_id" not in args:
+        args["task_id"] = args["ticket_id"]
+    tid = _require_task_id(args)
+    _enforce_worker_task_ownership(tid)
+    trigger_id = _require_text(args, "trigger_id", "trigger_id is required")
+    reason = _require_text(args, "reason", "reason is required")
+    with _board(args.get("board")) as (kb, conn):
+        _existing_task(kb, conn, tid)
+        from hermes_cli.orchestrator import trigger_handback
+        res = trigger_handback(conn, ticket_id=tid, trigger_id=trigger_id, reason=reason)
+        if isinstance(res, dict) and not res.get("ok", True):
+            return tool_error(res.get("error", "handback failed"))
+        if isinstance(res, str) and "error" in res:
+            return tool_error(res)
+        fields = dict(res) if isinstance(res, dict) else {}
+        fields.setdefault("ticket_id", tid)
+        fields.setdefault("trigger_id", trigger_id)
+        return _ok(**fields)
+
+
+def kanban_handback(trigger_id: str, reason: str, task_id: Optional[str] = None, board: Optional[str] = None) -> str:
+    """Hand back a trigger out of scope for the calling task (programmatic interface)."""
+    args: dict[str, Any] = {"trigger_id": trigger_id, "reason": reason}
+    if task_id:
+        args["task_id"] = task_id
+    if board:
+        args["board"] = board
+    return _handle_handback(args)
+
