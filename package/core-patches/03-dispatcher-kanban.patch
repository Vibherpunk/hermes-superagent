+class SlotPool:
+    """In-memory slot controller for superagent worker dispatch (E-023).
+
+    Capacity = worker_slots + reserve_slots.
+    - 'launch' acquires use the worker slots: succeeds if in_use() < worker_slots.
+    - 'person_wake' acquires can tap reserve slots: succeeds if in_use() < (worker_slots + reserve_slots).
+    """
+
+    def __init__(self, worker_slots: int, reserve_slots: int) -> None:
+        self.worker_slots = max(0, int(worker_slots))
+        self.reserve_slots = max(0, int(reserve_slots))
+        self._tokens: set[str] = set()
+        self._task_tokens: dict[Any, tuple[str, Optional[int]]] = {}
+        self._lock = threading.Lock()
+
+    @property
+    def capacity(self) -> int:
+        return self.worker_slots + self.reserve_slots
+
+    def in_use(self) -> int:
+        with self._lock:
+            return len(self._tokens)
+
+    def try_acquire(self, kind: str) -> Optional[str]:
+        if kind not in {"launch", "person_wake"}:
+            raise ValueError(f"Invalid slot acquire kind: {kind!r}")
+
+        with self._lock:
+            current = len(self._tokens)
+            if kind == "launch":
+                if current < self.worker_slots:
+                    token = str(uuid.uuid4())
+                    self._tokens.add(token)
+                    return token
+                return None
+            elif kind == "person_wake":
+                if current < (self.worker_slots + self.reserve_slots):
+                    token = str(uuid.uuid4())
+                    self._tokens.add(token)
+                    return token
+                return None
+            return None
+
+    def release(self, token: str) -> bool:
+        with self._lock:
+            for k, entry in list(self._task_tokens.items()):
+                tok = entry[0] if isinstance(entry, tuple) else entry
+                if tok == token:
+                    del self._task_tokens[k]
+            if token in self._tokens:
+                self._tokens.remove(token)
+                return True
+            raise ValueError(f"Unknown or already-released slot token: {token!r}")
+
+    def bind_task(
+        self, task_id: str, token: str, board: Optional[str] = None, run_id: Optional[int] = None
+    ) -> None:
+        """Associate an acquired slot token with a task id (and optional board/run)."""
+        with self._lock:
+            entry = (token, run_id)
+            self._task_tokens[(board, task_id)] = entry
+            self._task_tokens[task_id] = entry
+
+    def release_task(self, task_id: str, board: Optional[str] = None) -> bool:
+        """Release the slot token associated with task_id, exactly once.
+
+        Returns True if a token was found and released, False otherwise.
+        """
+        with self._lock:
+            entry = self._task_tokens.pop((board, task_id), None)
+            if entry is None:
+                entry = self._task_tokens.pop(task_id, None)
+            else:
+                self._task_tokens.pop(task_id, None)
+            if entry is not None:
+                token = entry[0] if isinstance(entry, tuple) else entry
+                if token in self._tokens:
+                    self._tokens.remove(token)
+                    return True
+            return False
+
+    def bound_tasks(self) -> list[tuple[Optional[str], str, str, Optional[int]]]:
+        """Return snapshot of (board, task_id, token, run_id) for currently bound tasks."""
+        with self._lock:
+            res: list[tuple[Optional[str], str, str, Optional[int]]] = []
+            for k, entry in list(self._task_tokens.items()):
+                if isinstance(k, tuple):
+                    b, tid = k
+                    tok = entry[0] if isinstance(entry, tuple) else entry
+                    rid = entry[1] if isinstance(entry, tuple) else None
+                    res.append((b, tid, tok, rid))
+            return res
+
+
+_SLOT_POOL_LOCK = threading.Lock()
+_GLOBAL_SLOT_POOL: Optional[SlotPool] = None
+
+
+def get_slot_pool(
+    *, reload: bool = False, config: Optional[dict[str, Any]] = None
+) -> Optional[SlotPool]:
+    """Return the in-memory SlotPool instance for the dispatcher process.
+
+    Returns None when superagent.enabled is false.
+    When enabled, creates or reuses the SlotPool sized from superagent_settings().
+    """
+    global _GLOBAL_SLOT_POOL
+    with _SLOT_POOL_LOCK:
+        if _GLOBAL_SLOT_POOL is not None and not reload:
+            return _GLOBAL_SLOT_POOL
+
+        try:
+            sa = superagent_settings(config)
+        except Exception:  # health: allow BLE001 -- fallback to disabled if settings resolution fails
+            sa = {"enabled": False}
+
+        if not sa.get("enabled", False):
+            _GLOBAL_SLOT_POOL = None
+            return None
+
+        _GLOBAL_SLOT_POOL = SlotPool(
+            worker_slots=sa.get("worker_slots", 4),
+            reserve_slots=sa.get("human_reserve_slots", 1),
+        )
+        return _GLOBAL_SLOT_POOL
+
+
+def reset_slot_pool(slot_pool: Optional[SlotPool] = None) -> None:
+    """Reset or inject the global SlotPool instance."""
+    global _GLOBAL_SLOT_POOL
+    with _SLOT_POOL_LOCK:
+        _GLOBAL_SLOT_POOL = slot_pool
+
+
+def acquire_lane_slot(
+    slot_pool: Any,
+    task_id: str,
+    lane: str,
+    result: Any,
+    dry_run: bool,
+    conn: sqlite3.Connection,
+    kind: str = "launch",
+) -> tuple[bool, Optional[str]]:
+    """Acquire a slot token for this task, or record slot_wait and return False."""
+    if slot_pool is None:
+        return True, None
+    token = slot_pool.try_acquire(kind)
+    if token is None:
+        if hasattr(result, "skipped_slot_wait"):
+            result.skipped_slot_wait.append(task_id)
+        if not dry_run:
+            from hermes_cli import kanban_db as _kb
+            with _kb.write_txn(conn):
+                _kb._append_event(conn, task_id, "slot_wait", {"lane": lane, "kind": kind})
+        return False, None
+    return True, token
+
+
+def release_lane_slot(slot_pool: Any, slot_token: Optional[str]) -> None:
+    """Release an unconsumed or aborted slot token."""
+    if slot_pool is not None and slot_token is not None:
+        with contextlib.suppress(Exception):
+            slot_pool.release(slot_token)
+
+
+def bind_lane_slot(
+    slot_pool: Any,
+    task_id: str,
+    slot_token: Optional[str],
+    board: Optional[str] = None,
+    run_id: Optional[int] = None,
+) -> None:
+    """Bind an acquired slot token to a spawned task and run."""
+    if slot_pool is not None and slot_token is not None and hasattr(slot_pool, "bind_task"):
+        slot_pool.bind_task(task_id, slot_token, board=board, run_id=run_id)
+
+
+def reclaim_ended_slots(
+    conn: sqlite3.Connection,
+    slot_pool: Any,
+    board: Optional[str] = None,
+) -> list[str]:
+    """Release slot tokens for tasks whose worker runs have ended (E-023)."""
+    if not hasattr(slot_pool, "bound_tasks") or not hasattr(slot_pool, "release_task"):
+        return []
+    released: list[str] = []
+    for b, tid, _tok, expected_run_id in slot_pool.bound_tasks():
+        if board is not None and b is not None and b != board:
+            continue
+        try:
+            row = conn.execute(
+                "SELECT status, current_run_id FROM tasks WHERE id = ?", (tid,)
+            ).fetchone()
+            if (
+                row is None
+                or row["status"] != "running"
+                or row["current_run_id"] is None
+                or (expected_run_id is not None and row["current_run_id"] != expected_run_id)
+            ):
+                if slot_pool.release_task(tid, board=b):
+                    released.append(tid)
+        except Exception:  # health: allow BLE001 -- best effort check during reclaim
+            continue
+    return released
