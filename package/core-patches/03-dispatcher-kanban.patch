+        def sender(address: dict[str, Any], body: str, purpose: str) -> dict[str, Any]:
+            platform_str = str(address.get("platform") or "").strip().lower()
+            plat = None
+            try:
+                plat = Platform(platform_str)
+            except ValueError:
+                pass
+
+            owner_profile = str(address.get("notifier_profile") or address.get("owner_profile") or "").strip() or None
+            adapter = None
+            if plat is not None:
+                adapter = _adapter_for_subscription(self, plat, address, owner_profile)
+                if adapter is None:
+                    adapter = (getattr(self, "adapters", {}) or {}).get(plat)
+            if adapter is None:
+                adapter = (getattr(self, "adapters", {}) or {}).get(platform_str)
+            if adapter is None:
+                raise RuntimeError(f"No active adapter for platform {platform_str!r}")
+
+            chat_id = str(address.get("chat_id") or "")
+            metadata = dict(address.get("delivery_metadata") or {})
+            if address.get("thread_id") and not metadata.get("thread_id"):
+                metadata["thread_id"] = address["thread_id"]
+            if address.get("reply_to") and not metadata.get("reply_to"):
+                metadata["reply_to"] = address["reply_to"]
+
+            scope_cm = contextlib.nullcontext()
+            if owner_profile and getattr(getattr(self, "config", None), "multiplex_profiles", False):
+                from gateway.run import _profile_runtime_scope
+                from gateway.session import SessionSource
+                source = SessionSource(platform=plat, chat_id=chat_id, profile=owner_profile)
+                try:
+                    home = self._resolve_profile_home_for_source(source)
+                    if home:
+                        scope_cm = _profile_runtime_scope(Path(home))
+                except Exception:
+                    pass
+
+            with scope_cm:
+                res = adapter.send(chat_id, body, metadata=metadata or None)
+                if asyncio.iscoroutine(res) or inspect.isawaitable(res):
+                    try:
+                        loop = asyncio.get_running_loop()
+                    except RuntimeError:
+                        loop = None
+                    if loop and loop.is_running():
+                        import concurrent.futures
+                        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
