+def superagent_settings(config: Optional[dict[str, Any]] = None) -> dict[str, Any]:
+    """Resolve and validate the superagent configuration block per E-033.
+
+    Defaults:
+      enabled: False
+      accept_mode: "observe"  # off | observe | auto
+      eval_timeout_seconds: 60
+      worker_slots: 4
+      human_reserve_slots: 1
+      router_profile: None
+      router_model: None
+      worker_model: None
+      rules: []
+      github: {repository: None, receive_all: {issues: False, pull_requests: False, comments: False, ci: False}}
+      sources: {}
+    """
+    if config is None:
+        try:
+            from hermes_cli.config import load_config
+            config = load_config()
+        except Exception:  # health: allow BLE001 -- fallback to empty dict if load_config fails
+            config = {}
+
+    sa_raw = config.get("superagent")
+    if sa_raw is None:
+        sa_raw = {}
+    elif not isinstance(sa_raw, dict):
+        raise ValueError(f"superagent must be a dict, got {type(sa_raw).__name__}")
+
+    enabled = bool(sa_raw.get("enabled", False))
+    accept_mode = sa_raw.get("accept_mode", "observe")
+    if accept_mode not in {"off", "observe", "auto"}:
+        raise ValueError(f"superagent.accept_mode must be 'off', 'observe', or 'auto', got {accept_mode!r}")
+
+    eval_timeout_seconds = int(sa_raw.get("eval_timeout_seconds", 60) or 60)
+
+    raw_worker_slots = sa_raw.get("worker_slots", 4)
+    if isinstance(raw_worker_slots, bool) or not isinstance(raw_worker_slots, (int, str)):
+        raise ValueError(f"superagent.worker_slots must be an integer >= 1, got {raw_worker_slots!r}")
+    try:
+        worker_slots = int(raw_worker_slots)
+        if worker_slots < 1:
+            raise ValueError()
+    except (TypeError, ValueError):
+        raise ValueError(f"superagent.worker_slots must be an integer >= 1, got {raw_worker_slots!r}")
+
+    raw_human_reserve = sa_raw.get("human_reserve_slots", 1)
+    if isinstance(raw_human_reserve, bool) or not isinstance(raw_human_reserve, (int, str)):
+        raise ValueError(f"superagent.human_reserve_slots must be an integer in {{0, 1}}, got {raw_human_reserve!r}")
+    try:
+        human_reserve_slots = int(raw_human_reserve)
+        if human_reserve_slots not in {0, 1}:
+            raise ValueError()
+    except (TypeError, ValueError):
+        raise ValueError(f"superagent.human_reserve_slots must be an integer in {{0, 1}}, got {raw_human_reserve!r}")
