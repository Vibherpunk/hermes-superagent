+    raw_router_profile = sa_raw.get("router_profile")
+    if raw_router_profile is not None and (not isinstance(raw_router_profile, str) or not raw_router_profile.strip()):
+        raise ValueError(f"superagent.router_profile must be a non-empty string or null, got {raw_router_profile!r}")
+    router_profile = raw_router_profile.strip() if isinstance(raw_router_profile, str) else None
+
+    router_model = sa_raw.get("router_model")
+    worker_model = sa_raw.get("worker_model")
+
+    raw_rules = sa_raw.get("rules", [])
+    if isinstance(raw_rules, list):
+        rules = list(raw_rules)
+    else:
