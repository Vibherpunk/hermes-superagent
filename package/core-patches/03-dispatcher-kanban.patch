+    def _drain_kanban_outbox(self, board: Optional[str] = None, now: Optional[float] = None) -> dict[str, int]:
+        """Drain due replies from the board's outbox using active platform adapters."""
+        import inspect
+        from hermes_cli import superagent_outbox as _outbox
+        from hermes_cli import kanban_db as _kb
+        from gateway.config import Platform
+        from gateway.kanban_watchers_notifier import _adapter_for_subscription
+
+        if now is None:
