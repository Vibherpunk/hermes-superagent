+def _counted_gate_attempts(conn: sqlite3.Connection, task_id: str, run_id: int):
+    """(count, last counted gate_failed payload) for one run — pairs each
+    ``gate_failed`` evidence event with its ``gate_attempt_counted`` decision
+    (§2.4).  Read-only; decisions are only ever MADE inside a write txn.
+    The pairing itself is the ONE shared implementation in
+    ``kanban_escalation.gate_attempt_decisions`` (FIX-19)."""
+    from hermes_cli.kanban_escalation import gate_attempt_decisions
+
+    counted = 0
+    last_payload: Optional[dict] = None
+    rows = conn.execute(
+        "SELECT id, payload FROM task_events WHERE task_id = ? AND run_id = ? AND kind = 'gate_failed' "
+        "ORDER BY id ASC", (task_id, int(run_id)),
+    ).fetchall()
+    decisions = gate_attempt_decisions(conn, task_id)
+    for row in rows:
+        dec = decisions.get(int(row["id"]))
+        if dec and dec.get("counted") is True:
+            counted += 1
+            last_payload = _json_dict(row["payload"])
+    return counted, last_payload
+
+
+def _last_event_id(conn: sqlite3.Connection) -> int:
+    row = conn.execute("SELECT last_insert_rowid() AS i").fetchone()
+    return int(row["i"])
+
+
+def _close_run_and_requeue_in_txn(conn: sqlite3.Connection, task_id: str, *, outcome: str,
+                                  gate_meta: dict, error_text: str, summary_text: str) -> Optional[int]:
+    """Shared close-and-requeue helper (§2.4, F9): ``_end_run`` bookkeeping,
+    claim-field clearing, ``last_failure_error`` — as raw in-txn writes inside
+    the caller's ALREADY-OPEN write_txn.  Opens no txn itself."""
+    run_id = _end_run(
+        conn, task_id, outcome=outcome, status="failed",
+        summary=summary_text, error=error_text, metadata={"gate": gate_meta},
+    )
+    conn.execute(
+        "UPDATE tasks SET claim_lock = NULL, claim_expires = NULL, worker_pid = NULL, "
+        "worker_started_at = NULL, last_failure_error = ? WHERE id = ?",
+        (error_text[:500], task_id),
+    )
+    return run_id
+
+
+def _shape_a_block_in_txn(conn: sqlite3.Connection, task_id: str, *, kind: str, reason: str,
+                          source_status: str, prev_kind: Optional[str], prev_recurrences: int,
+                          run_id: Optional[int]) -> tuple:
+    """Shape A attention block (§2.4 call-site rule): ``block_task``'s complete
+    in-txn effect set as raw writes inside the caller's open txn — routing via
+    ``_route_block`` computed FROM THE PRESERVED SNAPSHOT, row write, and the
+    ``blocked``-family audit event in the same txn (stickiness, B-3b).  The
+    caller fires the ``kanban_task_blocked`` hook POST-COMMIT (item 6, N-6).
+    Returns (new_status, event_kind, payload)."""
+    new_status, event_kind, set_sql, params, payload = _route_block(
+        kind, reason, source_status, prev_kind=prev_kind, prev_recurrences=prev_recurrences,
+    )
+    conn.execute(
+        f"UPDATE tasks SET status = ?, claim_lock = NULL, claim_expires = NULL, "
+        f"worker_pid = NULL, {set_sql} WHERE id = ?",
+        (new_status, *params, task_id),
+    )
+    _append_event(conn, task_id, event_kind, payload, run_id=run_id)
+    return new_status, event_kind, payload
+
+
+def block_task_if_state(conn: sqlite3.Connection, task_id: str, *, kind: str, reason: Optional[str],
+                        expected_status: str, expected_block_kind: Optional[str] = None) -> bool:
+    """Shape B attention block (§2.4 call-site rule): post-commit guarded
+    wrapper.  Opens its OWN write_txn, re-reads state inside it, and only on a
+    match writes ``block_task``'s complete effect set (raw writes — never a
+    nested ``block_task`` call); fires the ``kanban_task_blocked`` hook after
+    its txn commits, exactly once, and only when it actually wrote the block
+    (N-6).  Returns True when the block was written."""
+    if kind not in VALID_BLOCK_KINDS:
+        raise ValueError(f"block kind must be one of {sorted(VALID_BLOCK_KINDS)}")
+    with write_txn(conn):
+        row = conn.execute(
+            "SELECT status, block_kind, block_recurrences FROM tasks WHERE id = ?", (task_id,),
+        ).fetchone()
+        if row is None or row["status"] != expected_status:
+            return False
+        if expected_block_kind is not None and _row_get(row, "block_kind") != expected_block_kind:
+            return False
+        # FIX-17: effect ordering aligned with block_task — routing decision
+        # and the row write FIRST (with an explicit status guard on the
+        # UPDATE, not just the pre-read), then run closure/synthesis, and
+        # only then the audit event carrying the closed/synthesized run's id.
+        new_status, event_kind, set_sql, params, payload = _route_block(
+            kind, reason, row["status"],
+            prev_kind=_row_get(row, "block_kind"),
+            prev_recurrences=int(_row_get(row, "block_recurrences") or 0),
+        )
+        cur = conn.execute(
+            f"UPDATE tasks SET status = ?, claim_lock = NULL, claim_expires = NULL, "
+            f"worker_pid = NULL, {set_sql} WHERE id = ? AND status = ?",
+            (new_status, *params, task_id, expected_status),
+        )
+        if cur.rowcount != 1:
+            raise RuntimeError("block_task_if_state: status guard failed mid-txn")
+        run_id = _end_or_synthesize_run(
+            conn, task_id, outcome="blocked", status="blocked", summary=reason,
+            synthesize=bool(reason),
+        )
+        _append_event(conn, task_id, event_kind, payload, run_id=run_id)
+        blocked_task = get_task(conn, task_id)
+    _fire_task_hook("kanban_task_blocked", blocked_task, task_id, run_id, reason=reason)
+    return True
+
+
+def set_spend_ceiling(conn: sqlite3.Connection, task_id: str, *, tokens: Optional[int] = None) -> bool:
+    """Per-ticket spend ceiling override (§4.4): tokens only in v1 (no USD
+    surface exists).  Built on the ``_set_task_override`` pattern: refuses
+    archived tasks, emits ``spend_ceiling_set``, notifies after commit."""
+    if tokens is not None and (not isinstance(tokens, int) or isinstance(tokens, bool) or tokens < 0):
+        raise ValueError("spend ceiling tokens must be a non-negative integer or None")
+    return _set_task_override(
+        conn, task_id,
+        "UPDATE tasks SET spend_ceiling_tokens = ? WHERE id = ?", (tokens,),
+        "spend_ceiling_set", {"tokens": tokens},
+        ("spend_ceiling_tokens",), archived_msg="cannot set spend ceiling",
+    )
+
+
+def _gate_failure_message(result, failed_id: Optional[str]) -> str:
+    for r in (result.results if result is not None else []):
+        if r.id == failed_id and not getattr(r, "skipped", False):
+            tail = (r.output_tail or "")[-1000:]
+            return f"gate check '{failed_id}' failed (exit_code={r.exit_code}, timed_out={r.timed_out}): {tail}"
+    return f"gate check '{failed_id}' failed"
+
+
+def _gate_env_sequence(conn: sqlite3.Connection, task_id: str, *, run_id: int, result,
+                       env_reason: str, gates_cfg: dict) -> None:
+    """Environment-failure atomic sequence (§2.4): transient park first, close
+    the run, infrastructure accounting (no counter, no breaker), then the
+    consecutive-env limit decides ready-return vs a Shape A ``gate_env``
+    block — routing computed from the PRESERVED snapshot (B-4/N-2)."""
+    snap = conn.execute(
+        "SELECT block_kind, block_recurrences FROM tasks WHERE id = ?", (task_id,),
+    ).fetchone()
+    prev_kind = _row_get(snap, "block_kind") if snap else None
+    prev_rec = int(_row_get(snap, "block_recurrences") or 0) if snap else 0
+    retry_status = _retry_status_for_run(conn, task_id, run_id)
+    gate_meta = _gate_meta(result, "env_fail", 0)
+    block_info = None
+    with write_txn(conn):
+        _append_event(conn, task_id, "gate_exhaustion_pending",
+                      {"run_id": run_id, "prev_block_kind": prev_kind,
+                       "prev_block_recurrences": prev_rec}, run_id=run_id)
+        conn.execute("UPDATE tasks SET status = 'blocked', block_kind = NULL WHERE id = ?", (task_id,))
+        _close_run_and_requeue_in_txn(
+            conn, task_id, outcome="gate_env_failed", gate_meta=gate_meta,
+            error_text=f"gate environment failure: {env_reason}",
+            summary_text=f"gate environment failure: {env_reason}",
+        )
+        _record_task_failure_in_txn(
+            conn, task_id, f"gate environment failure: {env_reason}",
+            outcome="gate_env_failed", infrastructure=True,
+        )
+        # Consecutive env failures since the latest reset point.
+        reset_id = 0
+        for kind_name in ("gate_passed", "completed", "unblocked"):
+            r = conn.execute(
+                "SELECT MAX(id) AS mid FROM task_events WHERE task_id = ? AND kind = ?",
+                (task_id, kind_name),
+            ).fetchone()
+            if r and r["mid"]:
+                reset_id = max(reset_id, int(r["mid"]))
+        env_count = conn.execute(
+            "SELECT COUNT(*) AS n FROM task_events WHERE task_id = ? AND kind = 'gate_env_failed' "
+            "AND run_id IS NOT NULL AND id > ?", (task_id, reset_id),
+        ).fetchone()["n"]
+        if int(env_count) >= int(gates_cfg.get("env_failure_limit", 3)):
+            new_status, _ek, _pl = _shape_a_block_in_txn(
+                conn, task_id, kind="gate_env",
+                reason=f"gate environment failures reached the limit ({env_reason})",
+                source_status=retry_status, prev_kind=prev_kind, prev_recurrences=prev_rec,
+                run_id=run_id,
+            )
+            block_info = ("gate_env", f"gate environment failures reached the limit ({env_reason})", new_status)
+        else:
+            conn.execute(
+                "UPDATE tasks SET status = ?, block_kind = ?, block_recurrences = ? WHERE id = ?",
+                (retry_status, prev_kind, prev_rec, task_id),
+            )
+    if block_info is not None:
+        _fire_task_hook("kanban_task_blocked", get_task(conn, task_id), task_id, run_id,
+                        reason=block_info[1])
+
+
+def _gate_exhaustion_sequence(conn: sqlite3.Connection, task_id: str, *, run_id: int, result,
+                              evidence_payload: dict, gates_cfg: dict,
+                              board_config: Optional[dict],
+                              board_errors: Optional[list] = None) -> str:
+    """Worker-exhaustion atomic sequence (§2.4): ONE write_txn — evidence +
+    counting decision + transient park + close + breaker accounting +
+    structured accounting (§4.1/§4.3) + final status from the preserved
+    snapshot (N-2 restoration on non-block outcomes).  Returns 'exhausted',
+    'not_exhausted', or 'already_exhausted' (FIX-1: a revived evaluator
+    re-entering for a run whose exhaustion already committed performs NO
+    second accounting — evidence only).  The caller raises the matching
+    GateFailedError."""
+    from hermes_cli import kanban_board_config as _kbcfg
+    from hermes_cli import kanban_escalation as _ke
+
+    snap = conn.execute(
+        "SELECT block_kind, block_recurrences FROM tasks WHERE id = ?", (task_id,),
+    ).fetchone()
+    prev_kind = _row_get(snap, "block_kind") if snap else None
+    prev_rec = int(_row_get(snap, "block_recurrences") or 0) if snap else 0
+    retry_status = _retry_status_for_run(conn, task_id, run_id)
+    max_attempts = int(gates_cfg.get("max_attempts_per_run", 3))
+    # Escalation config comes from the caller's ONE board-config snapshot
+    # (FIX-12: threaded through the gated completion; no mid-operation
+    # reload).  A direct caller without a snapshot loads one here, before
+    # the atomic txn opens (B-9/B-11 discipline).
+    if board_config is not None:
+        _bcfg, _berrs = board_config, (board_errors or [])
+    else:
+        _bcfg, _berrs = _kbcfg.load_board_config()
+    esc_enabled = _kbcfg.feature_enabled(_bcfg, _berrs, "escalation")
+    esc_threshold = int(_kbcfg.section_config(_bcfg, "escalation").get("threshold", 2))
+    esc_board_config = _bcfg
+    failed_id = result.failed_check if result is not None else None
+    error_text = f"gate checks exhausted: {failed_id}"
+    block_info = None
+    notify = False
+    unresolvable_final_status: Optional[str] = None
+    outcome = "exhausted"
+    with write_txn(conn):
+        # FIX-1 exhaustion idempotency: if this run's exhaustion was already
+        # recorded (a counted gate_attempt_counted decision with
+        # exhausted=true for THIS run), or the run is already closed / no
+        # longer the task's current run, a revived evaluator degrades to
+        # evidence-only — NO second counted decision, NO second
+        # consecutive/structured accounting, NO second escalation evaluation.
+        _task_row = conn.execute(
+            "SELECT current_run_id FROM tasks WHERE id = ?", (task_id,),
+        ).fetchone()
+        _run_row = conn.execute(
+            "SELECT ended_at FROM task_runs WHERE id = ?", (int(run_id),),
+        ).fetchone()
+        _already = False
+        if _run_row is None or _run_row["ended_at"] is not None:
+            _already = True
+        elif _task_row is None or _task_row["current_run_id"] != run_id:
+            _already = True
+        else:
+            from hermes_cli.kanban_escalation import gate_attempt_decisions as _decisions
+            for _ev_id, _dec in _decisions(conn, task_id).items():
+                if _dec.get("run_id") == run_id and _dec.get("counted") is True \
+                        and _dec.get("exhausted") is True:
+                    _already = True
+                    break
+        if _already:
+            _append_event(conn, task_id, "gate_failed", evidence_payload, run_id=run_id)
+            return "already_exhausted"
+        attempts_before, _last = _counted_gate_attempts(conn, task_id, run_id)
+        attempt = attempts_before + 1
+        if attempt < max_attempts:
+            _append_event(conn, task_id, "gate_failed", evidence_payload, run_id=run_id)
+            ev_id = _last_event_id(conn)
+            _append_event(conn, task_id, "gate_attempt_counted",
+                          {"gate_failed_event_id": ev_id, "run_id": run_id, "counted": True,
+                           "attempt": attempt, "exhausted": False, "no_change_retry": False},
+                          run_id=run_id)
+            return "not_exhausted"
+        _append_event(conn, task_id, "gate_failed", evidence_payload, run_id=run_id)
+        ev_id = _last_event_id(conn)
+        _append_event(conn, task_id, "gate_attempt_counted",
+                      {"gate_failed_event_id": ev_id, "run_id": run_id, "counted": True,
+                       "attempt": attempt, "exhausted": True, "no_change_retry": False},
+                      run_id=run_id)
+        _append_event(conn, task_id, "gate_exhaustion_pending",
+                      {"run_id": run_id, "prev_block_kind": prev_kind,
+                       "prev_block_recurrences": prev_rec}, run_id=run_id)
+        conn.execute("UPDATE tasks SET status = 'blocked', block_kind = NULL WHERE id = ?", (task_id,))
+        gate_meta = _gate_meta(result, "worker_fail", attempt)
+        _close_run_and_requeue_in_txn(
+            conn, task_id, outcome="gate_failed", gate_meta=gate_meta,
+            error_text=error_text, summary_text=_first_line(_gate_failure_message(result, failed_id), 200),
+        )
+        acct = _record_task_failure_in_txn(
+            conn, task_id, error_text, outcome="gate_failed", infrastructure=False,
+            retry_status=retry_status, run_id=run_id,
+        )
+        esc = _ke.record_gate_exhaustion_in_txn(
+            conn, task_id, run_id=run_id, evidence=evidence_payload,
+            enabled=esc_enabled, threshold=esc_threshold, board_config=esc_board_config,
+        )
+        notify = bool(esc.get("seat_changed"))
+        if acct.get("tripped"):
+            # FIX-6 (DESIGN §2.4(d)/(f)): the breaker outcome PRE-EMPTS the
+            # already-escalated gate_worker routing in the both-trip case —
+            # status remains blocked (gave_up) and the preserved snapshot is
+            # restored exactly (N-2).  No Shape A block, no recurrence
+            # consumption, no blocked-family event from this sequence.
+            conn.execute(
+                "UPDATE tasks SET status = 'blocked', block_kind = ?, block_recurrences = ? WHERE id = ?",
+                (prev_kind, prev_rec, task_id),
+            )
+            final_status = "blocked"
+        elif esc.get("action") == "already_blocked":
+            # Already-escalated epoch (§4.3 step 4): real attention block,
+            # routed from the preserved snapshot.
+            new_status, _ek, _pl = _shape_a_block_in_txn(
+                conn, task_id, kind="gate_worker",
+                reason="structured failures continue after frontier escalation",
+                source_status=retry_status, prev_kind=prev_kind, prev_recurrences=prev_rec,
+                run_id=run_id,
+            )
+            final_status = new_status
+            block_info = ("gate_worker", "structured failures continue after frontier escalation")
+        else:
+            conn.execute(
+                "UPDATE tasks SET status = ?, block_kind = ?, block_recurrences = ? WHERE id = ?",
+                (retry_status, prev_kind, prev_rec, task_id),
+            )
+            final_status = retry_status
+        if esc.get("action") == "unresolvable":
+            unresolvable_final_status = final_status
+    if notify:
+        notify_task_updated(conn, task_id, ("model_override", "provider_override", "reasoning_effort"))
+    if block_info is not None:
+        _fire_task_hook("kanban_task_blocked", get_task(conn, task_id), task_id, run_id,
+                        reason=block_info[1])
+    if unresolvable_final_status is not None:
+        block_task_if_state(
+            conn, task_id, kind="capability",
+            reason="escalation target seat unresolvable for assignee profile",
+            expected_status=unresolvable_final_status,
+        )
+    return outcome
+
+
+
+# ---------------------------------------------------------------------------
+# Cross-run gate exhaustion (AMENDMENT-DESIGN-REV2, Option D): refused-run
+# accounting.  A worker that makes exactly one completion attempt per run and
+# ends its session on the refusal never reaches the in-run exhaustion above;
+# its run closes as a protocol violation instead.  The functions below count
+# such REFUSED RUNS (R-1) per (task, current spec hash, current spec tenure)
+# and, at kanban.gates.max_refused_runs, fire the structured-failure
+# consequences through the reused escalation increment — the protocol-
+# violation breaker is never consulted for a refused run (R-5).
+# ---------------------------------------------------------------------------
+
+class _CrossRunAbort(Exception):
+    """Internal control flow: abort the cross-run accounting transaction
+    (the increment returned ``disabled``, so no refused event, no mint
+    marker, and no status change may commit).  Converted by the dispatcher's
+    per-detail guard into the legacy fallback, like any Zone-1 failure."""
+
+
+def _last_counted_gate_failed(conn: sqlite3.Connection, task_id: str, run_id: int):
+    """(event_id, payload, decision) of the run's LAST counted gate failure,
+    paired via the ONE shared pairing implementation
+    (``gate_attempt_decisions``).  (None, None, None) when the run carries
+    no counted refusal."""
+    from hermes_cli.kanban_escalation import gate_attempt_decisions
+
+    decisions = gate_attempt_decisions(conn, task_id)
+    found = (None, None, None)
+    rows = conn.execute(
+        "SELECT id, payload FROM task_events WHERE task_id = ? AND run_id = ? "
+        "AND kind = 'gate_failed' ORDER BY id ASC", (task_id, int(run_id)),
+    ).fetchall()
+    for row in rows:
+        dec = decisions.get(int(row["id"]))
+        if dec is not None and dec.get("counted") is True:
+            found = (int(row["id"]), _json_dict(row["payload"]), dec)
+    return found
+
+
+def _gate_refused_for_run(conn: sqlite3.Connection, task_id: str, run_id: int) -> bool:
+    """The refused-run predicate (AMENDMENT-DESIGN-REV2 R-1).  Read-only.
+    Clauses are evaluated in the normative order: (a) spec'd task and
+    (b) PV closure are plain row reads, and ONLY when both hold is the
+    attempt pairing consulted for (c)-(f)."""
+    # (a) the task exists and carries a gate spec at accounting time.
+    trow = conn.execute(
+        "SELECT gate_spec FROM tasks WHERE id = ?", (task_id,),
+    ).fetchone()
+    if trow is None or trow["gate_spec"] is None:
+        return False
+    # (b) the run was closed by the crash reclaim as a protocol violation
+    # (clean exit while still running): outcome crashed + the PV marker.
+    rrow = conn.execute(
+        "SELECT outcome, metadata, ended_at FROM task_runs WHERE id = ? AND task_id = ?",
+        (int(run_id), task_id),
+    ).fetchone()
+    if rrow is None or rrow["ended_at"] is None:
+        return False
+    if (rrow["outcome"] or "") != "crashed":
+        return False
+    if not _json_dict(rrow["metadata"]).get("protocol_violation"):
+        return False
+    # (c)-(f) via the shared pairing implementation.
+    from hermes_cli.kanban_escalation import gate_attempt_decisions
+
+    decisions = gate_attempt_decisions(conn, task_id)
+    last_counted_id = None
+    rows = conn.execute(
+        "SELECT id FROM task_events WHERE task_id = ? AND run_id = ? "
+        "AND kind = 'gate_failed' ORDER BY id ASC", (task_id, int(run_id)),
+    ).fetchall()
+    for row in rows:
+        dec = decisions.get(int(row["id"]))
+        if dec is None:
+            continue
+        # (e) an exhausted decision for this run means in-run exhaustion
+        # already owned the closure — never a refused run.
+        if dec.get("exhausted") is True:
+            return False
+        if dec.get("counted") is True:
+            last_counted_id = int(row["id"])
+    # (c) at least one counted worker-class refusal in this run.
+    if last_counted_id is None:
+        return False
+    # (d) RUN-scoped pass carve-out: a gate_passed for this run AFTER the
+    # last counted refusal proves the episode ended inside the run.
+    prow = conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id = ? AND run_id = ? "
+        "AND kind = 'gate_passed' AND id > ? LIMIT 1",
+        (task_id, int(run_id), last_counted_id),
+    ).fetchone()
+    if prow is not None:
+        return False
+    # (f) a mixed worker->env run is owned by the env sequence (Q-9): any
+    # gate_env_failed for this run disqualifies it, explicitly.
+    erow = conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id = ? AND run_id = ? "
+        "AND kind = 'gate_env_failed' LIMIT 1", (task_id, int(run_id)),
+    ).fetchone()
+    if erow is not None:
+        return False
+    return True
+
+
+def _refused_window_floor(conn: sqlite3.Connection, task_id: str) -> int:
+    """The refused-run window floor (R-3): the greatest event id among the
+    latest ``completed`` event (the epoch boundary), the latest mint event
+    (a cross-run mint, or a counted decision whose OWN payload carries
+    ``exhausted: true`` — the flag lives on the decision payload itself),
+    and the latest spec-change boundary event (an ``edited`` event whose
+    payload ``fields`` list contains ``"gate_spec"``).  0 when none."""
+    floor = 0
+    for kind in ("completed", "gate_cross_run_exhaustion"):
+        row = conn.execute(
+            "SELECT MAX(id) AS m FROM task_events WHERE task_id = ? AND kind = ?",
+            (task_id, kind),
+        ).fetchone()
+        if row is not None and row["m"]:
+            floor = max(floor, int(row["m"]))
+    for row in conn.execute(
+        "SELECT id, payload FROM task_events WHERE task_id = ? "
+        "AND kind = 'gate_attempt_counted'", (task_id,),
+    ).fetchall():
+        if _json_dict(row["payload"]).get("exhausted") is True:
+            floor = max(floor, int(row["id"]))
+    for row in conn.execute(
+        "SELECT id, payload FROM task_events WHERE task_id = ? AND kind = 'edited'",
+        (task_id,),
+    ).fetchall():
+        fields = _json_dict(row["payload"]).get("fields")
+        if isinstance(fields, list) and "gate_spec" in fields:
+            floor = max(floor, int(row["id"]))
+    return floor
+
+
+def _refused_window(conn: sqlite3.Connection, task_id: str, floor: int, spec_hash):
+    """(count, refused run ids, refused gate_failed event ids) for the
+    ``gate_run_refused`` events above ``floor`` whose payload ``spec_hash``
+    equals the task's current spec hash, in event order."""
+    count = 0
+    run_ids: list = []
+    gf_ids: list = []
+    for row in conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? "
+        "AND kind = 'gate_run_refused' AND id > ? ORDER BY id ASC",
+        (task_id, int(floor)),
+    ).fetchall():
+        payload = _json_dict(row["payload"])
+        if payload.get("spec_hash") == spec_hash:
+            count += 1
+            run_ids.append(payload.get("run_id"))
+            gf_ids.append(payload.get("gate_failed_event_id"))
+    return count, run_ids, gf_ids
+
+
+def _pending_unresolvable_marker(conn: sqlite3.Connection, task_id: str):
+    """The durable pending marker for a missed Shape B capability landing:
+    the id of the latest ``escalation_unresolvable`` event in the current
+    epoch with NO subsequent resolution (a capability ``blocked``-family
+    event consumes it; a ``completed`` event moots it via the epoch floor),
+    or None."""
+    epoch_row = conn.execute(
+        "SELECT MAX(id) AS m FROM task_events WHERE task_id = ? AND kind = 'completed'",
+        (task_id,),
+    ).fetchone()
+    epoch = int(epoch_row["m"] or 0) if epoch_row is not None else 0
+    marker = None
+    for row in conn.execute(
+        "SELECT id, kind, payload FROM task_events WHERE task_id = ? AND id > ? "
+        "ORDER BY id ASC", (task_id, epoch),
+    ).fetchall():
+        if row["kind"] == "escalation_unresolvable":
+            marker = int(row["id"])
+        elif row["kind"] in ("blocked", "block_loop_detected"):
+            if _json_dict(row["payload"]).get("kind") == "capability":
+                marker = None
+    return marker
+
+
+def _gate_refused_run_accounting(conn: sqlite3.Connection, task_id: str, *,
+                                 run_id: int, board_config: tuple) -> dict:
+    """Cross-run refused-run accounting (AMENDMENT-DESIGN-REV2 §A5.2).
+
+    ``board_config`` is the (config, errors) TUPLE from the caller's ONE
+    board-config load; step 0 unpacks it and only the dict element is ever
+    passed onward.  Zone 1 (the single write transaction) may raise — the
+    dispatcher's per-detail guard converts that to the legacy fallback.
+    The post-commit tail contains its own per-step guards and raises
+    nothing."""
+    from hermes_cli import kanban_board_config as _kbcfg
+    from hermes_cli import kanban_escalation as _ke
+    from hermes_cli import kanban_gates as _kg
+
+    # Step 0 (Q-1, normative): unpack the snapshot tuple; from here on only
+    # the DICT element flows to the increment, the section readers, and the
+    # feature checks (which take the errors list as a separate argument).
+    cfg, errs = board_config
+    result: dict = {}
+    seat_changed = False
+    block_reason = None
+    with write_txn(conn):
+        # (i) Re-verify inside the transaction (stored values only).
+        trow = conn.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
+        if (trow is None or trow["status"] not in ("ready", "review")
+                or trow["current_run_id"] is not None):
+            return {"outcome": "state_moved"}
+        source_status = trow["status"]
+        dup = conn.execute(
+            "SELECT payload FROM task_events WHERE task_id = ? "
+            "AND kind = 'gate_run_refused'", (task_id,),
+        ).fetchall()
+        for drow in dup:
+            if _json_dict(drow["payload"]).get("run_id") == int(run_id):
+                return {"outcome": "already_accounted"}
+        if trow["gate_spec"] is None:
+            return {"outcome": "state_moved"}
+        cur_hash = _kg.spec_hash(trow["gate_spec"])
+        gf_id, gf_payload, gf_decision = _last_counted_gate_failed(conn, task_id, run_id)
+        if gf_id is None:
+            return {"outcome": "state_moved"}
+        if gf_payload.get("spec_hash") != cur_hash:
+            return {"outcome": "spec_changed"}
+        # Full predicate re-run in-txn (the authority; the dispatcher's
+        # pre-check is a fast path only).
+        if not _gate_refused_for_run(conn, task_id, run_id):
+            return {"outcome": "state_moved"}
+        crow = conn.execute(
+            "SELECT 1 FROM task_events WHERE task_id = ? AND kind = 'completed' "
+            "AND id > ? LIMIT 1", (task_id, gf_id),
+        ).fetchone()
+        if crow is not None:
+            return {"outcome": "state_moved"}
+        # (ii) Record the refused run, then count the window including it.
+        floor = _refused_window_floor(conn, task_id)
+        prior_count, prior_run_ids, prior_gf_ids = _refused_window(
+            conn, task_id, floor, cur_hash)
+        window_count = prior_count + 1
+        _append_event(conn, task_id, "gate_run_refused", {
+            "run_id": int(run_id), "spec_hash": cur_hash,
+            "gate_failed_event_id": gf_id,
+            "attempt_in_run": (gf_decision or {}).get("attempt"),
+            "failed_check": gf_payload.get("failed_check"),
+            "window_count": window_count,
+        }, run_id=int(run_id))
+        gates_cfg = _kbcfg.section_config(cfg, "gates")
+        max_refused = int(gates_cfg.get("max_refused_runs", 3))
+        # (iii) Below budget: commit with the refused event only.
+        if window_count < max_refused:
+            result = {"outcome": "accounted", "window_count": window_count}
+        else:
+            # (iv) At budget: mint in the SAME transaction — increment FIRST.
+            esc_enabled = _kbcfg.feature_enabled(cfg, errs, "escalation")
+            esc_threshold = int(
+                _kbcfg.section_config(cfg, "escalation").get("threshold", 2))
+            esc = _ke.record_gate_exhaustion_in_txn(
+                conn, task_id, run_id=int(run_id), evidence=gf_payload,
+                enabled=esc_enabled, threshold=esc_threshold, board_config=cfg)
+            if esc.get("action") == "disabled":
+                # Snapshot/in-txn disagreement: abort the whole unit — no
+                # refused event, no mint marker, no floor, no anchor.
+                raise _CrossRunAbort(
+                    "cross-run increment returned 'disabled' after the "
+                    "accounting snapshot evaluated escalation as enabled")
+            action = esc.get("action")
+            seat_changed = bool(esc.get("seat_changed"))
+            # Mint marker AFTER the increment, in the same transaction, so
+            # its existence certifies a counted structured failure.
+            _wcount, refused_run_ids, refused_gf_ids = _refused_window(
+                conn, task_id, floor, cur_hash)
+            failed_check = gf_payload.get("failed_check")
+            check_argv: list = []
+            for rec in (gf_payload.get("checks") or []):
+                if isinstance(rec, dict) and rec.get("id") == failed_check:
+                    check_argv = list(rec.get("argv") or [])
+                    break
+            manifests = []
+            for evid in refused_gf_ids:
+                erow = conn.execute(
+                    "SELECT payload FROM task_events WHERE id = ?", (evid,),
+                ).fetchone()
+                if erow is not None:
+                    fp = _json_dict(erow["payload"]).get("fingerprint")
+                    manifests.append(
+                        fp.get("manifest_hash") if isinstance(fp, dict) else None)
+            anchor_fp = gf_payload.get("fingerprint")
+            if not isinstance(anchor_fp, dict):
+                anchor_fp = None
+            _append_event(conn, task_id, "gate_cross_run_exhaustion", {
+                "spec_hash": cur_hash,
+                "refused_run_ids": refused_run_ids,
+                "window_count": window_count,
+                "budget": max_refused,
+                "failed_check": failed_check,
+                "check_argv": check_argv,
+                "no_tree_change_across_runs": bool(manifests)
+                    and all(m == manifests[0] for m in manifests),
+                "anchor_gate_failed_event_id": gf_id,
+                "anchor_run_id": int(run_id),
+                "anchor_head_sha": (anchor_fp or {}).get("head_sha"),
+                "anchor_fingerprint": anchor_fp,
+            }, run_id=int(run_id))
+            # (v) Final status by escalation action — never via the unified
+            # failure accounting (its trip would write the untyped park this
+            # path exists to replace).
+            if action == "already_blocked":
+                block_reason = (
+                    f"cross-run gate exhaustion: check '{failed_check}' kept "
+                    f"failing across {window_count} refused runs "
+                    f"(spec_hash {cur_hash}); structured failures continue "
+                    f"after frontier escalation")
+                _shape_a_block_in_txn(
+                    conn, task_id, kind="gate_worker", reason=block_reason,
+                    source_status=source_status,
+                    prev_kind=trow["block_kind"],
+                    prev_recurrences=int(trow["block_recurrences"] or 0),
+                    run_id=int(run_id))
+                result = {"outcome": "exhausted_blocked",
+                          "window_count": window_count,
+                          "count": esc.get("count"), "action": action,
+                          "seat_changed": seat_changed}
+            else:
+                result = {"outcome": "exhausted", "window_count": window_count,
+                          "count": esc.get("count"), "action": action,
+                          "seat_changed": seat_changed}
+    # --- ZONE 2: post-commit tail (SYNC-POSTCOMMIT-MINT-TAIL) ---
+    # Each step is individually guarded; a failure never skips the remaining
+    # steps, never re-enters any legacy fallback, and never propagates.
+    # Step 1: pending-marker re-drive — attempt the Shape B capability block
+    # for an unconsumed unresolvable marker (this pass's, or an earlier one).
+    try:
+        marker_id = _pending_unresolvable_marker(conn, task_id)
+        if marker_id is not None:
+            srow = conn.execute(
+                "SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
+            cur_status = srow["status"] if srow is not None else None
+            if cur_status in ("ready", "review"):
+                block_task_if_state(
+                    conn, task_id, kind="capability",
+                    reason="escalation target seat unresolvable for assignee profile",
+                    expected_status=cur_status)
+    except Exception:
+        _log.error(
+            "kanban: cross-run Shape B re-drive failed for %s (marker stays "
+            "pending for the next accounting pass)", task_id, exc_info=True)
+    # Step 2: seat-change notification (cosmetic loss class if it fails).
+    if seat_changed:
+        try:
+            notify_task_updated(
+                conn, task_id,
+                ("model_override", "provider_override", "reasoning_effort"))
+        except Exception:
+            _log.error(
+                "kanban: cross-run seat-change notification failed for %s "
+                "(seat is committed on the row; notification dropped)",
+                task_id, exc_info=True)
+    # Step 3: the Shape A block hook, exactly once, post-commit.
+    if block_reason is not None:
+        _fire_task_hook("kanban_task_blocked", get_task(conn, task_id),
+                        task_id, int(run_id), reason=block_reason)
+    return result
+
+def _gate_evaluate_locked(conn: sqlite3.Connection, task_id: str, *, row, canonical: str,
+                          gates_cfg: dict, board_config, lease_holder: str, lease_ttl: int,
+                          board_errors: Optional[list] = None) -> dict:
+    """Step G body, executed under the gate lease (§2.3).  Returns the pass
+    outcome (token + run metadata); raises GateFailedError / GateEnvError on
+    failure (all failure txns have committed by the time it raises)."""
+    try:
+        from hermes_cli import kanban_gates as _kg
+    except Exception as exc:  # FIX-14: import failure -> env outcome, not a crash
+        raise GateEnvError(f"gate environment failure: runner_error (import: {exc})",
+                           env_reason="runner_error", task_id=task_id) from exc
+
+    run_id = row["current_run_id"]
+    run_id = int(run_id) if run_id is not None else None
+    # G2: resolve the workspace directory.
+    cwd: Optional[str] = None
+    ws_path = row["workspace_path"]
+    if ws_path and os.path.isdir(str(ws_path)):
+        cwd = str(ws_path)
+    elif row["workspace_kind"] == "worktree":
+        try:
+            from hermes_cli.kanban_db_workspace import resolve_workspace
+            task_obj = get_task(conn, task_id)
+            resolved = resolve_workspace(task_obj) if task_obj is not None else None
+            if resolved is not None and os.path.isdir(str(resolved)):
+                cwd = str(resolved)
+        except Exception:
+            cwd = None
+    attach_dir = task_attachments_dir(task_id)
+    exclude_roots = [attach_dir]
+    globs = _kg.spec_exclude_globs(canonical)
+
+    def _env_fail(env_reason: str, result=None, checks_records=None):
+        spec_h = _kg.spec_hash(canonical)
+        payload = {
+            "spec_hash": spec_h, "classification": "environment", "env_reason": env_reason,
+            "infrastructure": True,
+            "checks": checks_records if checks_records is not None else (
+                _gate_check_records(result) if result is not None else []),
+        }
+        if result is not None:
+            payload["fingerprint"] = result.pre_gate_fingerprint
+        with write_txn(conn):
+            _append_event(conn, task_id, "gate_env_failed", payload, run_id=run_id)
+        if run_id is None:
+            raise GateEnvError(f"gate environment failure: {env_reason}",
+                               env_reason=env_reason, task_id=task_id)
+        _gate_env_sequence(conn, task_id, run_id=run_id, result=result,
+                           env_reason=env_reason, gates_cfg=gates_cfg)
+        raise GateEnvError(f"gate environment failure: {env_reason}",
+                           env_reason=env_reason, task_id=task_id)
+
+    if cwd is None:
+        _env_fail("workspace_missing")
+    # G3: hard invariant — no write txn may be open while subprocesses run.
+    if conn.in_transaction:
+        raise GateRunnerError("gate evaluation attempted inside an open write txn (§2.3 G3)")
+    try:
+        result = _kg.run_gate_spec(
+            canonical, cwd=cwd,
+            lease_renew=lambda: _gate_lease_renew(conn, task_id, lease_holder, lease_ttl),
+            exclude_roots=exclude_roots,
+        )
+    except _kg.GateSpecError:
+        _env_fail("spec_corrupt")
+    except GateRunnerError:
+        raise
+    except Exception:
+        _env_fail("runner_error")
+
+    records = _gate_check_records(result)
+    max_attempts = int(gates_cfg.get("max_attempts_per_run", 3))
+
+    if result.verdict == "pass":
+        attempts_before, _last = _counted_gate_attempts(conn, task_id, run_id) if run_id is not None else (0, None)
+        with write_txn(conn):
+            _append_event(conn, task_id, "gate_passed", {
+                "spec_hash": result.spec_hash,
+                "checks": [{"id": r.id, "argv": list(r.argv), "exit_code": 0,
+                            "duration_ms": int(r.duration_ms)}
+                           for r in result.results if not getattr(r, "skipped", False)],
+                "duration_ms": int(result.duration_ms),
+                "fingerprint": result.fingerprint,
+                "pre_gate_fingerprint": result.pre_gate_fingerprint,
+            }, run_id=run_id)
+        token = {
+            "task_id": task_id, "run_id": run_id, "spec_hash": result.spec_hash,
+            "fingerprint": result.fingerprint, "pre_gate_fingerprint": result.pre_gate_fingerprint,
+            "gate_spec_text": row["gate_spec"], "cwd": cwd,
+        }
+        return {"mode": "pass", "token": token,
+                "meta": _gate_meta(result, "pass", attempts_before)}
+
+    if result.verdict == "env_fail":
+        _env_fail(result.env_reason or "runner_error", result=result, checks_records=records)
+
+    # Worker failure.
+    evidence_payload = {
+        "spec_hash": result.spec_hash, "classification": "worker",
+        "checks": records, "failed_check": result.failed_check,
+        "fingerprint": result.pre_gate_fingerprint,
+        "after_fingerprint": result.fingerprint,
+        "check_written_paths": list(result.check_written_paths)[:2000],
+        "fingerprint_cmp": _kg.entries_hash_excluding(
+            result.pre_entries, set(result.check_written_paths)),
+    }
+    message = _gate_failure_message(result, result.failed_check)
+    if run_id is None:
+        payload = dict(evidence_payload)
+        payload["runless"] = True
+        with write_txn(conn):
+            _append_event(conn, task_id, "gate_failed", payload, run_id=None)
+        raise GateFailedError(message, exhausted=False, task_id=task_id)
+    attempts_before, last_payload = _counted_gate_attempts(conn, task_id, run_id)
+    if attempts_before >= 1 and last_payload is not None:
+        # No-change retry (rulings 2+3; F-1): compare this attempt's PRE-GATE
+        # entries — excluding the previous attempt's check-written paths —
+        # against the previous counted attempt's comparison hash.  FIX-15:
+        # the comparison ALSO requires full §2.2 fingerprint equality over
+        # the remaining components INCLUDING head_sha — a commit-only change
+        # (HEAD moves, manifest unchanged) IS a fix attempt and must count.
+        prev_written = set(last_payload.get("check_written_paths") or [])
+        prev_cmp = last_payload.get("fingerprint_cmp")
+        if prev_cmp is not None:
+            cur_cmp = _kg.entries_hash_excluding(result.pre_entries, prev_written)
+            prev_fp = last_payload.get("fingerprint") or {}
+            cur_fp = result.pre_gate_fingerprint or {}
+            no_change = (
+                cur_cmp == prev_cmp
+                and cur_fp.get("head_sha") == prev_fp.get("head_sha")
+                and cur_fp.get("is_git") == prev_fp.get("is_git")
+                and cur_fp.get("weak") == prev_fp.get("weak")
+            )
+        else:
+            no_change = _kg.fingerprints_equal(result.pre_gate_fingerprint,
+                                               last_payload.get("fingerprint"))
+        if no_change:
+            with write_txn(conn):
+                _append_event(conn, task_id, "gate_failed", evidence_payload, run_id=run_id)
+                ev_id = _last_event_id(conn)
+                _append_event(conn, task_id, "gate_attempt_counted",
+                              {"gate_failed_event_id": ev_id, "run_id": run_id, "counted": False,
+                               "attempt": None, "exhausted": False, "no_change_retry": True},
+                              run_id=run_id)
+            raise GateFailedError(message, exhausted=False, task_id=task_id)
+    if attempts_before + 1 < max_attempts:
+        # FIX-1: capture the evidence event id in ITS OWN txn (the
+        # _last_event_id pattern the other paths use) and pair the decision
+        # to THAT id — never SELECT MAX(id), which a revived/concurrent
+        # evaluator's evidence event could steal.
+        with write_txn(conn):
+            _append_event(conn, task_id, "gate_failed", evidence_payload, run_id=run_id)
+            ev_id = _last_event_id(conn)
+        with write_txn(conn):
+            # Decision txn: re-count authoritatively, then stamp the decision.
+            recount, _l = _counted_gate_attempts(conn, task_id, run_id)
+            _append_event(conn, task_id, "gate_attempt_counted",
+                          {"gate_failed_event_id": ev_id, "run_id": run_id, "counted": True,
+                           "attempt": recount + 1, "exhausted": False, "no_change_retry": False},
+                          run_id=run_id)
+        raise GateFailedError(message, exhausted=False, task_id=task_id)
+    # Exhaustion: evidence + counting + accounting commit atomically (§2.4).
+    outcome = _gate_exhaustion_sequence(
+        conn, task_id, run_id=run_id, result=result,
+        evidence_payload=evidence_payload, gates_cfg=gates_cfg, board_config=board_config,
+        board_errors=board_errors,
+    )
+    raise GateFailedError(message, exhausted=(outcome in ("exhausted", "already_exhausted")),
+                          task_id=task_id)
+
+
+def _gate_evaluate_for_completion(conn: sqlite3.Connection, task_id: str,
+                                  board_snapshot: Optional[tuple] = None) -> dict:
+    """Step G entry (§2.3): board-config gate, fresh snapshot, spec validation,
+    lease acquisition, evaluation.  Returns an outcome dict; on pass the lease
+    stays held (the caller releases it after the main completion txn).
+
+    FIX-14 (§2.6/§4.0): the new-module imports are function-local and wrapped —
+    an import failure on the completion path degrades to the ``runner_error``
+    env outcome for spec'd cards, never a ``complete_task`` crash."""
+    try:
+        from hermes_cli import kanban_board_config as _kbcfg
+        from hermes_cli import kanban_gates as _kg
+    except Exception as exc:
+        # Degrade through the §2.4 environment sequence using DB-only
+        # machinery (mirrors the spec_corrupt branch below): evidence event
+        # + env sequence + GateEnvError.  Unspec'd cards never reach here
+        # (complete_task calls step G only for spec'd cards).
+        _row = conn.execute(
+            "SELECT current_run_id FROM tasks WHERE id = ?", (task_id,),
+        ).fetchone()
+        if _row is None:
+            return {"mode": "none", "token": None, "meta": None, "lease_holder": None}
+        _run_id = _row["current_run_id"]
+        with write_txn(conn):
+            _append_event(conn, task_id, "gate_env_failed", {
+                "spec_hash": None, "classification": "environment",
+                "env_reason": "runner_error", "infrastructure": True, "checks": [],
+            }, run_id=int(_run_id) if _run_id is not None else None)
+        if _run_id is not None:
+            _gate_env_sequence(conn, task_id, run_id=int(_run_id), result=None,
+                               env_reason="runner_error", gates_cfg={})
+        raise GateEnvError(f"gate environment failure: runner_error (import: {exc})",
+                           env_reason="runner_error", task_id=task_id) from exc
+
+    none_outcome = {"mode": "none", "token": None, "meta": None, "lease_holder": None}
+    # FIX-12: reuse the caller's ONE board-config snapshot when threaded.
+    if board_snapshot is not None:
+        config, errors = board_snapshot
+    else:
+        config, errors = _kbcfg.load_board_config()
+    # FIX-4 (§5.1 per-section isolation): the gates consumer surfaces ONLY
+    # the gates section's errors, and only when gates are enabled in config
+    # and this consumer is exercised.  Disabled paths emit nothing.
+    _kbcfg.surface_if_exercised(conn, task_id, config, errors, "gates")
+    if not _kbcfg.feature_enabled(config, errors, "gates"):
+        return none_outcome
+    gates_cfg = _kbcfg.section_config(config, "gates")
+    row = conn.execute(
+        "SELECT status, current_run_id, gate_spec, workspace_kind, workspace_path "
+        "FROM tasks WHERE id = ?", (task_id,),
+    ).fetchone()
+    if row is None or not row["gate_spec"]:
+        return none_outcome
+    if row["status"] == "review":
+        return {"mode": "exempt_review", "token": None, "meta": None, "lease_holder": None}
+    default_timeout = gates_cfg.get("default_timeout_seconds", 300)
+    try:
+        canonical = _kg.validate_gate_spec(row["gate_spec"], default_timeout_seconds=int(default_timeout))
+    except ValueError:
+        # Corrupt stored spec: environment failure at completion (§2.1/§2.4).
+        run_id = row["current_run_id"]
+        with write_txn(conn):
+            _append_event(conn, task_id, "gate_env_failed", {
+                "spec_hash": None, "classification": "environment",
+                "env_reason": "spec_corrupt", "infrastructure": True, "checks": [],
+            }, run_id=int(run_id) if run_id is not None else None)
+        if run_id is None:
+            raise GateEnvError("gate environment failure: spec_corrupt",
+                               env_reason="spec_corrupt", task_id=task_id)
+        _gate_env_sequence(conn, task_id, run_id=int(run_id), result=None,
+                           env_reason="spec_corrupt", gates_cfg=gates_cfg)
+        raise GateEnvError("gate environment failure: spec_corrupt",
+                           env_reason="spec_corrupt", task_id=task_id)
+    if canonical is None:
+        return none_outcome
+    timeouts = _kg.spec_timeouts(canonical)
+    lease_ttl = max(1200, sum(timeouts) + 900)
+    holder = _gate_lease_acquire(conn, task_id, lease_ttl)
