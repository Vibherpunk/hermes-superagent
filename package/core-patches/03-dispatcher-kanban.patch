+    NULL-counter tolerance on both paths; the ``gave_up`` payload always
+    carries ``retry_status`` and the event always carries a run_id (the
+    ``_end_run`` run when ``end_run``, else ``gave_up_run_id`` — the gate
+    path passes its closing run).  In ``in_txn_mode`` the caller owns ALL
+    status/claim/run writes: the core performs only the counter UPDATE
+    (guarded to live statuses incl. the gate transient ``blocked``) and the
+    ``gave_up`` event on a trip."""
+    if failure_limit is None:
+        failure_limit = DEFAULT_FAILURE_LIMIT
+    error = (error or "")[:500]
+    row = conn.execute(
+        "SELECT consecutive_failures, status, max_retries, current_run_id "
+        "FROM tasks WHERE id = ?", (task_id,),
+    ).fetchone()
+    if row is None:
+        return {"failures": 0, "tripped": False,
+                "effective_limit": int(failure_limit), "row_missing": True}
+    retry_status = retry_status_override if retry_status_override is not None else (
+        _kb._retry_status_for_run(conn, task_id, row["current_run_id"])
+        if release_claim
+        else ("review" if row["status"] == "review" else "ready")
+    )
+    failures = int(row["consecutive_failures"] or 0) + (0 if infrastructure else 1)
+    task_override = _kb._row_get(row, "max_retries")
+    if task_override is not None:
+        effective_limit, limit_source = int(task_override), "task"
