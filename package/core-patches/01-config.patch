diff --git a/hermes_cli/config_value_checks.py b/hermes_cli/config_value_checks.py
index 14c5bd5ad8..2fbfb2a191 100644
--- a/hermes_cli/config_value_checks.py
+++ b/hermes_cli/config_value_checks.py
@@ -73,3 +73,70 @@ def _validate_web_backends(config: dict[str, Any], issues: list[ConfigIssue]) ->
                    f"web.{_key} is set to '{_val}', but {note} — "
                    "web_search/web_extract will fail until it is changed",
                    "Run 'hermes tools' and pick a different Web Search & Extract provider")
+
+
+def _validate_superagent(config: dict[str, Any], issues: list[ConfigIssue]) -> None:
+    """Validate superagent block per E-033:
+    accept_mode in {off, observe, auto}, worker_slots >= 1, human_reserve_slots in {0, 1}.
+    """
+    sa_cfg = config.get("superagent")
+    if sa_cfg is None:
+        return
+    if not isinstance(sa_cfg, dict):
+        _issue(issues, "error", f"superagent must be a mapping, got {type(sa_cfg).__name__}",
+               "Configure superagent as a YAML mapping")
+        return
+
+    if "accept_mode" in sa_cfg:
+        mode = sa_cfg.get("accept_mode")
+        if mode not in {"off", "observe", "auto"}:
+            _issue(issues, "error",
+                   f"superagent.accept_mode must be 'off', 'observe', or 'auto', got {mode!r}",
+                   "Set superagent.accept_mode to off, observe, or auto")
+
+    if "worker_slots" in sa_cfg:
+        slots = sa_cfg.get("worker_slots")
+        if not isinstance(slots, int) or isinstance(slots, bool) or slots < 1:
+            _issue(issues, "error",
+                   f"superagent.worker_slots must be an integer >= 1, got {slots!r}",
+                   "Set superagent.worker_slots to at least 1")
+
+    if "human_reserve_slots" in sa_cfg:
+        res = sa_cfg.get("human_reserve_slots")
+        if not isinstance(res, int) or isinstance(res, bool) or res not in {0, 1}:
+            _issue(issues, "error",
+                   f"superagent.human_reserve_slots must be 0 or 1, got {res!r}",
+                   "Set superagent.human_reserve_slots to 0 or 1")
+
+    if "router_profile" in sa_cfg:
+        rp = sa_cfg.get("router_profile")
+        if rp is not None and (not isinstance(rp, str) or not rp.strip()):
+            _issue(issues, "error",
+                   f"superagent.router_profile must be a non-empty string or null, got {rp!r}",
+                   "Set superagent.router_profile to a profile name string or null")
+
+    if "passthrough" in sa_cfg:
+        pt = sa_cfg.get("passthrough")
+        if not isinstance(pt, bool):
+            _issue(issues, "error",
+                   f"superagent.passthrough must be a boolean, got {pt!r}",
+                   "Set superagent.passthrough to true or false")
+
+    if "vibehard" in sa_cfg:
+        vh = sa_cfg.get("vibehard")
+        if vh is not None and not isinstance(vh, dict):
+            _issue(issues, "error",
+                   f"superagent.vibehard must be a mapping, got {type(vh).__name__}",
+                   "Configure superagent.vibehard as a YAML mapping")
+        elif isinstance(vh, dict):
+            if "enabled" in vh and not isinstance(vh["enabled"], bool):
+                _issue(issues, "error",
+                       f"superagent.vibehard.enabled must be a boolean, got {vh['enabled']!r}",
+                       "Set superagent.vibehard.enabled to true or false")
+            if "stuck_after_seconds" in vh:
+                sas = vh["stuck_after_seconds"]
+                if not isinstance(sas, int) or isinstance(sas, bool) or sas < 1:
+                    _issue(issues, "error",
+                           f"superagent.vibehard.stuck_after_seconds must be an integer >= 1, got {sas!r}",
+                           "Set superagent.vibehard.stuck_after_seconds to at least 1")
+
