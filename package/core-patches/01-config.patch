diff --git a/cli-config.yaml.example b/cli-config.yaml.example
index 170dac3412..a718e2b69f 100644
--- a/cli-config.yaml.example
+++ b/cli-config.yaml.example
@@ -410,6 +410,31 @@ model:
 kanban:
   review_dispatch: true
 
+# =============================================================================
+# Super-agent Configuration
+# =============================================================================
+# Super-agent (executor-pack Phase 0). enabled: false = stock Hermes behavior; nothing in this build activates unless enabled is set true.
+superagent:
+  enabled: false            # master switch; false = today's Hermes, untouched
+  accept_mode: observe      # off | observe | auto
+  eval_timeout_seconds: 60
+  worker_slots: 4
+  human_reserve_slots: 1
+  router_model: null        # {provider, model} or null = profile default
+  worker_model: null
+  rules: []                 # [{name, instruction}]
+  # Example rule pack:
+  # rules:
+  #   - name: "reproduce-first"
+  #     instruction: "on a bug report in an auto Source, reproduce before replying; deliver only if reproduced AND the fix is <50 lines; otherwise record silently."
+  #
+  # Silence-rule note: sources/rules may mark work record-only — no reply, no
+  # acknowledgement — and silence is a valid, intended outcome, not a failure.
+  github:
+    repository: null        # "owner/name" or null = Source off
+    receive_all: {issues: false, pull_requests: false, comments: false, ci: false}
+  sources: {}               # per-source parts: {<source>: {allowlist: [], admission: {}, bots: []}}
+
 # =============================================================================
 # Terminal Tool Configuration
 # =============================================================================
