+def _sa_snapshot_envelopes(session) -> list:
+    """Snapshot queued envelopes as (object_reference, text) pairs (A31-8).
+
+    The envelope OBJECT is held, not just its id(): a detached id() can be
+    recycled after garbage collection and proves nothing about identity.
+    """
+    snapshot = []
+    envelopes = []
+    if session.get("queued_prompt"):
+        envelopes.append(session["queued_prompt"])
+    envelopes.extend(session.get("queued_prompts") or [])
+    for envelope in envelopes:
+        if isinstance(envelope, dict):
+            snapshot.append((envelope, envelope.get("text")))
+    return snapshot
+
+
+def _sa_envelope_landed(session, snapshot, text) -> bool:
+    """Whether a busy submit's text actually landed in the queue (A31-8).
+
+    Landed iff any of: (i) a fresh envelope (not a held snapshot object)
+    whose text equals the submitted text; (ii) a held envelope whose
+    non-empty snapshot text grew by exactly "\\n\\n" + text (the merge
+    form); (iii) a held envelope whose snapshot text was empty and whose
+    text is now exactly the submitted text (``prev or text``). A dropped
+    self-duplicate satisfies none of these and records nothing.
+    """
+    current = []
+    if session.get("queued_prompt"):
+        current.append(session["queued_prompt"])
+    current.extend(session.get("queued_prompts") or [])
+    for envelope in current:
+        if not isinstance(envelope, dict):
+            continue
+        if all(envelope is not held for held, _ in snapshot) and envelope.get("text") == text:
+            return True
+    for held, old_text in snapshot:
+        now_text = held.get("text")
+        if old_text and now_text == f"{old_text}\n\n{text}":
+            return True
+        if not old_text and now_text == text and bool(text):
+            return True
+    return False
+
