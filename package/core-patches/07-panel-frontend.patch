+  getAttentionTickets: (stage?: string, board?: string) => {
+    const params: string[] = [];
+    if (stage) params.push(`stage=${encodeURIComponent(stage)}`);
+    if (board) params.push(`board=${encodeURIComponent(board)}`);
+    const q = params.length > 0 ? `?${params.join("&")}` : "";
+    return fetchJSON<AttentionTicket[]>(`/api/plugins/kanban/attention/tickets${q}`);
+  },
