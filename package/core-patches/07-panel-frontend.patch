+    limit?: number;
+    board?: string;
+  }) => {
+    const params: string[] = [];
+    if (options?.outcome) params.push(`outcome=${encodeURIComponent(options.outcome)}`);
+    if (options?.limit !== undefined) params.push(`limit=${options.limit}`);
+    if (options?.board) params.push(`board=${encodeURIComponent(options.board)}`);
+    const q = params.length > 0 ? `?${params.join("&")}` : "";
+    return fetchJSON<AttentionDecision[]>(
+      `/api/plugins/kanban/attention/decisions${q}`,
+    );
+  },
+  getAttentionSettings: (board?: string) => {
+    const q = board ? `?board=${encodeURIComponent(board)}` : "";
+    return fetchJSON<AttentionSettingsResponse>(
+      `/api/plugins/kanban/attention/settings${q}`,
