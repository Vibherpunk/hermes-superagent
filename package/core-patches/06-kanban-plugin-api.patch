+# --- Superagent Attention Panel Endpoints (Phase 5.3) -----------------------
+
+def _require_superagent_enabled() -> None:
+    """Ensure superagent is enabled in config; raise HTTP 404 when disabled."""
+    cfg = _load_config_or_empty()
+    sa_cfg = (cfg.get("superagent") or {}) if isinstance(cfg, dict) else {}
+    if not bool(sa_cfg.get("enabled", False)):
+        raise HTTPException(status_code=http_status.HTTP_404_NOT_FOUND, detail="superagent is disabled")
+
+
+@router.get("/attention/overview")
+def get_attention_overview(board: Optional[str] = _BOARD_Q):
+    """Aggregate attention panel overview: health, 24h flows, needs_person, and tickets by stage."""
+    _require_superagent_enabled()
+    with _board_conn(board) as (board, conn):
+        return orchestrator_reads.overview(conn)
+
+
+@router.get("/attention/threads")
+def get_attention_threads(board: Optional[str] = _BOARD_Q):
+    """List distinct thread keys with their latest trigger and decision summaries."""
+    _require_superagent_enabled()
+    with _board_conn(board) as (board, conn):
+        return orchestrator_reads.threads(conn)
+
+
+@router.get("/attention/thread/{thread_key}")
+def get_attention_thread(thread_key: str, board: Optional[str] = _BOARD_Q):
+    """Return chronological event timeline for a specific thread_key."""
+    _require_superagent_enabled()
+    with _board_conn(board) as (board, conn):
+        return orchestrator_reads.thread_timeline(conn, thread_key)
+
+
+@router.get("/attention/decisions")
