+# --- Superagent Attention Panel POST Actions (Phase 5.3 POST) ---------------
+def _handle_sa_post(fn: Callable, args: dict[str, Any], fail: str) -> dict[str, Any]:
+    res = json.loads(fn(args))
+    if not res.get("ok"):
+        err = res.get("error", fail)
+        raise HTTPException(status_code=404 if "not found" in err.lower() else 400, detail=err)
+    return res
+
+@router.post("/attention/ticket/{ticket_id}/stop")
+@router.post("/attention/ticket/stop")
+def stop_attention_ticket(ticket_id: Optional[str] = None, payload: Optional[dict[str, Any]] = Body(None), board: Optional[str] = _BOARD_Q):
+    _require_superagent_enabled()
+    tid = ticket_id or (payload or {}).get("ticket_id") or (payload or {}).get("task_id")
+    if not tid: raise HTTPException(status_code=400, detail="ticket_id is required")
+    with _board_conn(board) as (board, conn):
+        res = orchestrator.stop_ticket(conn, tid, reason=(payload or {}).get("reason"))
+        if isinstance(res, str): raise HTTPException(status_code=404, detail=res)
+        return res
+
+@router.post("/attention/ticket/{ticket_id}/retry")
+@router.post("/attention/ticket/retry")
+def retry_attention_ticket(ticket_id: Optional[str] = None, payload: Optional[dict[str, Any]] = Body(None), board: Optional[str] = _BOARD_Q):
+    _require_superagent_enabled()
+    tid = ticket_id or (payload or {}).get("ticket_id") or (payload or {}).get("task_id")
+    if not tid: raise HTTPException(status_code=400, detail="ticket_id is required")
+    return _handle_sa_post(orchestrator_tools._handle_ticket_retry, {"task_id": tid, "reason": (payload or {}).get("reason"), "board": board}, "ticket retry failed")
+
+@router.post("/attention/decision/{decision_id}/dismiss")
+@router.post("/attention/decision/dismiss")
+def dismiss_attention_decision(decision_id: Optional[int] = None, payload: Optional[dict[str, Any]] = Body(None), board: Optional[str] = _BOARD_Q):
+    _require_superagent_enabled()
+    did = decision_id if decision_id is not None else (payload or {}).get("decision_id") or (payload or {}).get("id")
+    if did is None: raise HTTPException(status_code=400, detail="decision_id is required")
+    return _handle_sa_post(orchestrator_tools._handle_eval_decide, {"decision_id": did, "decision": "dismiss", "board": board}, "decision dismiss failed")
+
