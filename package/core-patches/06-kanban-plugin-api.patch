+def reevaluate_attention_trigger(trigger_id: Optional[str] = None, payload: Optional[dict[str, Any]] = Body(None), board: Optional[str] = _BOARD_Q):
+    _require_superagent_enabled()
+    trg = trigger_id or (payload or {}).get("trigger_id") or (payload or {}).get("task_id")
+    if not trg: raise HTTPException(status_code=400, detail="trigger_id is required")
