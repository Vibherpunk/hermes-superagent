+@router.post("/attention/processing")
+def set_attention_processing(payload: Optional[dict[str, Any]] = Body(None), board: Optional[str] = _BOARD_Q):
+    _require_superagent_enabled()
+    p = payload or {}
+    return pause_attention_processing(board=board) if (p.get("paused") is True or p.get("action") == "pause") else resume_attention_processing(board=board)
