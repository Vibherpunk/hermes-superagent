+def _ctx_gate_evidence(lines: list[str], conn: sqlite3.Connection, task_id: str, now: int) -> None:
+    """Gate evidence for the next worker (DESIGN rev 4, §2.4): the most recent
+    2 ``gate_failed``/``gate_env_failed`` events, each output tail capped at
+    3,000 chars, under a fixed heading."""
+    try:
+        rows = conn.execute(
+            "SELECT kind, payload FROM task_events WHERE task_id = ? "
+            "AND kind IN ('gate_failed', 'gate_env_failed') ORDER BY id DESC LIMIT 2",
+            (task_id,),
+        ).fetchall()
+    except Exception:
+        return
+    if not rows:
+        return
+    lines.append("## Gate evidence (must pass before completion)")
+    for row in rows:
+        payload = _kb._json_dict(row["payload"]) if hasattr(_kb, "_json_dict") else {}
+        if not payload:
+            try:
+                import json as _json
+                payload = _json.loads(row["payload"] or "{}")
+            except Exception:
+                payload = {}
+        failed = payload.get("failed_check") or payload.get("env_reason") or row["kind"]
+        lines.append(f"### {row['kind']} — {failed}")
+        for check in payload.get("checks") or []:
+            if not isinstance(check, dict) or check.get("skipped"):
+                continue
+            tail = str(check.get("output_tail") or "")[:3000]
+            lines.append(
+                f"- check `{check.get('id')}` exit_code={check.get('exit_code')} "
+                f"timed_out={check.get('timed_out')}"
+            )
+            if tail:
+                lines.append(tail[:3000])
+        lines.append("")
+
